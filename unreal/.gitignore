# Unreal Engine 5 generated/derived directories -- never commit these.
Binaries/
Intermediate/
Saved/
DerivedDataCache/
Build/

# Per-user IDE project files generated by "Generate Visual Studio project files".
.vs/
.vscode/
.idea/
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.VC.opendb
*.xcodeproj
*.xcworkspace

# Editor autosave / crash reports.
Saved/Autosaves/
Saved/Crashes/

# Plugin binaries (source plugins are fine to commit; their build output is not).
Plugins/*/Binaries/
Plugins/*/Intermediate/

.DS_Store
Thumbs.db
